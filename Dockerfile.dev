# Local development image only — NOT used for AWS Lambda deployment.
# The Lambda deploy path uses backend/Dockerfile (see terraform + CI/CD).
FROM python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir poetry

COPY pyproject.toml poetry.lock ./
RUN poetry config virtualenvs.create false \
    && poetry install --no-root

COPY . .

EXPOSE 8000

CMD ["poetry", "run", "uvicorn", "src.verity_portal.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
